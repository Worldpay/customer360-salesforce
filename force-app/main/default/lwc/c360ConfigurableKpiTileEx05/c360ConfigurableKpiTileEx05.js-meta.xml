<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>C360 KPI Tile (configurable) (ex_05)</masterLabel>
    <description>Single KPI tile; App Builder selects metric from C360 Metric Definition CMDT via Apex picklist.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property
                name="metricKey"
                type="String"
                label="Metric"
                datasource="apex://C360MetricKeyPicklist"
                default="total_accounts"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
