<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>C360 Portfolio Health</masterLabel>
    <description>Health counts and cross-sell pipeline summary.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="title" type="String" default="Portfolio health" label="Panel title"/>
            <property name="interactive" type="Boolean" default="false" label="Clickable health tiles (Accounts Hub)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
