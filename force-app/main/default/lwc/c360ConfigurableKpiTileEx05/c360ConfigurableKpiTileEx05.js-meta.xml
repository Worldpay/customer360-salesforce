<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>C360 KPI Tile (configurable) (ex_05)</masterLabel>
    <description>Single KPI tile; App Builder picklist selects metric from C360 Metric Definition CMDT.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="metricKey" type="String" label="Metric" datasource="picklist" default="total_accounts">
                <value name="total_accounts" label="Total accounts"/>
                <value name="composite_health_index" label="Composite health index"/>
                <value name="signals_to_action" label="Signals to action"/>
                <value name="at_risk_accounts" label="At-risk accounts"/>
                <value name="revenue_at_risk" label="Revenue at risk"/>
            </property>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
